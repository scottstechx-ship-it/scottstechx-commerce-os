# ScottsTechX backend — required env.
# Copy to .env and fill in real values. Never commit the real .env.

# --- Required ---
# JWT signing secret. Must be >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-me-with-a-48-byte-random-string-please-please-please

# Postgres connection string. For Supabase:
#   postgres://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# For self-hosted Postgres + embedded-postgres (dev only):
#   postgres://app:***@127.0.0.1:5433/scottstechx
DATABASE_URL=postgres://app:***@127.0.0.1:5433/scottstechx

# --- Optional: AI provider (set to enable AI features) ---
# AI_PROVIDER is one of: openai | anthropic | gemini | nvidia
# Without a matching key, AI endpoints return 503 ai_disabled.
AI_PROVIDER=nvidia
LLM_API_KEY=
# NVIDIA NIM (OpenAI-compatible). https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Set to 1 to enable the Nemotron "thinking" reasoning budget.
AI_REASONING=0
# Model to use. Defaults are sensible per provider.
# OpenAI: gpt-4o-mini | Anthropic: claude-3-5-sonnet-latest
# Gemini: gemini-1.5-flash | NVIDIA: nvidia/nemotron-3-ultra-550b-a55b
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Optional: Firebase Auth (signup + Google OAuth via Firebase) ---
# The Android client signs users up/in with the Firebase Auth SDK and sends the
# ID token to POST /api/v1/auth/firebase. Set one of:
#   - FIREBASE_ADMIN_CREDENTIAL_JSON: the full service-account JSON (one line)
#   - GOOGLE_APPLICATION_CREDENTIALS: path to the service-account JSON file
# On Cloud Run, leave the credential unset (ADC is used) and just set
# FIREBASE_PROJECT_ID to advertise that Firebase Auth is enabled.
FIREBASE_PROJECT_ID=scottstechx-52bab
FIREBASE_ADMIN_CREDENTIAL_JSON=

# --- Optional: Nylon Pay (mobile-money payments) ---
# https://nylonpay.nilesquad.com — keys from the merchant dashboard.
NYLONPAY_API_KEY=
NYLONPAY_API_SECRET=
NYLONPAY_BASE_URL=
# Webhook signing secret — set in the Nylon Pay dashboard when registering
# https://<your-host>/api/v1/payments/webhook
NYLONPAY_WEBHOOK_SECRET=
# PAYMENT_PROVIDER: "nylonpay" (default when keys are set) or "demo"
# (auto-approve locally/tests). Fail-closed: never auto-selected.
PAYMENT_PROVIDER=

# --- Optional: Google OAuth (direct Google JWKS verification; legacy path) ---
# Get this from Google Cloud Console -> APIs & Services -> Credentials ->
#   Create OAuth 2.0 Client ID -> Web application
# Copy the Client ID here. The Android client uses it as ServerClientId for
# Credential Manager's Google Identity One-Tap flow.
GOOGLE_CLIENT_ID=

# --- Optional: CORS allow-list (comma-separated origins) ---
# Used by the optional web admin client. Mobile apps ignore this.
# In development, all origins are allowed unless this is set explicitly.
ALLOWED_ORIGINS=https://admin.scottstechx.example,https://app.scottstechx.example

# --- Server ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
