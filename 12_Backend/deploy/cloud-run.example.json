{
  "_comment": "Documentation only — not consumed at runtime. Run `gcloud run deploy` with these env vars (use Secret Manager for the secrets).",
  "name": "scottstechx-api",
  "runtime": "nodejs22",
  "region": "us-central1",
  "source": ".",
  "memory": "512Mi",
  "cpu": 1,
  "concurrency": 80,
  "timeoutSeconds": 60,
  "env": {
    "NODE_ENV": "production",
    "PORT": "3001",
    "LOG_LEVEL": "info",
    "JWT_SECRET": "@scottstechx-jwt-secret",
    "DATABASE_URL": "@scottstechx-db-url",
    "AI_PROVIDER": "nvidia",
    "NVIDIA_API_KEY": "@scottstechx-nvidia-key",
    "NVIDIA_BASE_URL": "https://integrate.api.nvidia.com/v1",
    "AI_MODEL": "nvidia/nemotron-3-ultra-550b-a55b",
    "FIREBASE_PROJECT_ID": "scottstechx-52bab",
    "NYLONPAY_API_KEY": "@scottstechx-nylon-key",
    "NYLONPAY_API_SECRET": "@scottstechx-nylon-secret",
    "NYLONPAY_WEBHOOK_SECRET": "@scottstechx-nylon-webhook-secret",
    "PAYMENT_PROVIDER": "nylonpay",
    "GOOGLE_CLIENT_ID": "@scottstechx-google-client-id",
    "ALLOWED_ORIGINS": "https://admin.scottstechx.example,https://app.scottstechx.example"
  },
  "ingress": "all"
}
